# Frontend: enable integrations only after their services are configured.
VITE_ENABLE_SUPABASE=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_EMAIL_OTP=false
VITE_ENABLE_GOOGLE_MAPS=false
VITE_GOOGLE_MAPS_API_KEY=
VITE_RIGDESK_CALL_NUMBER=

# Server-side only: configure in the serverless hosting environment.
# Optional server overrides; otherwise functions use the VITE Supabase URL/anon key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BOND_PDF_SECRET=
BOND_VERIFY_BASE_URL=https://rigdesk-marketplace-rig-logi-x.vercel.app/verify/
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-only escrow integration. Leave disabled until migrations and provider onboarding pass staging checks.
PAYMENTS_ENABLED=false
PAYMENTS_LIVE_MODE=false
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# At least 32 characters; authenticate an external scheduler calling the POST worker endpoint.
PAYMENT_WORKER_SECRET=
